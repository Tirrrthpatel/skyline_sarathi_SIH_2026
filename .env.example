# ==============================================================================
# Skyline सारथी - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# 1. Create a project at https://console.cloud.google.com/
# 2. Configure OAuth consent screen
# 3. Create Credentials -> OAuth 2.0 Client IDs (Web Application)
# 4. Add Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Airspace Cartography Tile Servers (Leaflet)
VITE_TILE_AVIATION_VECTOR=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_TILE_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TILE_OSM=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Backend Microservice URLs
VITE_FASTAPI_BASE=http://localhost:8000/api
VITE_FLASK_BASE=http://localhost:5000/api

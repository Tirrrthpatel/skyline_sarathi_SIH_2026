# ==============================================================================
# Security & Credentials - NEVER COMMIT TO GIT OR PUSH TO REPOSITORIES
# ==============================================================================
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
Frontend/.env
Frontend/.env.*
backend/.env
backend/.env.*

# Allow example template files to be committed
!*.env.example
!**/*.env.example

# ==============================================================================
# Node.js & Frontend Dependencies / Build Output
# ==============================================================================
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
dist-ssr/
build/
*.local
.pnp
.pnp.js

# Cache directories
.vite/
Frontend/.vite/
.eslintcache
.cache/

# ==============================================================================
# Python & Backend Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# ==============================================================================
# Logs
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# OS & IDE Files
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.agents/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
